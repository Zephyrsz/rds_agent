# Shared runtime configuration for DuckDB Tools, RDS Agent and DeepSeek Harness.
DUCKDB_TOOLS_ROOT=/app/duckdb_tools
RDS_AGENT_ROOT=/app/rds_agent
HARNESS_ROOT=/app/deepseek-harness
HARNESS_WORKSPACE_ROOT=/app/rds_agent/workspace
RDS_AGENT_PYTHON=/home/ubuntu/venv_314/bin/python

DUCKDB_TOOLS_HOST=0.0.0.0
DUCKDB_TOOLS_BACKEND_PORT=8001
DUCKDB_TOOLS_FRONTEND_PORT=5175
# Browser API prefix when the workbench is served below Nginx /admin/.
VITE_API_URL=/admin/api
DUCKDB_TOOLS_DATA=/app/rds_agent/data
DUCKDB_TOOLS_DATABASE=/app/rds_agent/data/workspace.duckdb
RDS_AGENT_METADATA_DB=/app/rds_agent/data/metadata.db

RDS_DB_PATH=/app/rds_agent/data/workspace.duckdb
RDS_METADATA_DB_PATH=/app/rds_agent/data/metadata.db
RDS_CONFIG_DIR=/app/rds_agent/config
RDS_LLM_BASE_URL=https://api.deepseek.com
RDS_LLM_MODEL=deepseek-chat

HARNESS_HOST=127.0.0.1
HARNESS_PORT=3090
# Nginx terminates the public request on port 80, so Harness must trust the
# authority seen by the browser rather than its loopback listener port.
HARNESS_TRUSTED_HOST=54.70.213.240
